# Environment Configuration Example
GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
HOST=0.0.0.0

# Frontend API URL Configuration
VITE_API_BASE_URL=http://localhost:8000
# Must match backend's TOOLFORGE_API_KEY when that is set; leave blank otherwise.
VITE_TOOLFORGE_API_KEY=

# ToolForge backend hardening
# Comma-separated list of origins allowed to call the backend from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Log verbosity for the backend (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
# Optional shared-secret key required on every /api/* request via the X-ToolForge-Key header.
# Leave unset/blank to disable auth entirely (default, convenient for local dev).
TOOLFORGE_API_KEY=

# Authentication Credentials for External Tools / APIs
# Placeholders for server-side auth credentials (never hardcode in source or frontend)
AUTH_BEARER_TOKEN=your_bearer_token_here
API_KEY=your_api_key_here
X_API_KEY=your_x_api_key_here
BASIC_AUTH_TOKEN=your_basic_auth_token_here

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
